<script>
  window.fkkLoadAfterPageReady = window.fkkLoadAfterPageReady || (function () {
    var callbacks = [];
    var hasRun = false;

    function runCallbacks() {
      if (hasRun) return;
      hasRun = true;
      callbacks.splice(0).forEach(function (callback) {
        try {
          callback();
        } catch (error) {
          setTimeout(function () {
            throw error;
          });
        }
      });
    }

    function scheduleAfterLoad() {
      setTimeout(runCallbacks, 1200);
    }

    window.addEventListener('load', scheduleAfterLoad, { once: true });
    ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (eventName) {
      window.addEventListener(eventName, runCallbacks, { once: true, passive: true });
    });

    return function (callback) {
      callbacks.push(callback);
      if (hasRun) runCallbacks();
    };
  })();
</script>
