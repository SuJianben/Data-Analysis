    <script>
      (function () {
        function setTextIfNeeded(node, nextText) {
          if (!node) return;
          var current = (node.textContent || '').trim();
          if (!current || current === nextText) return;
          node.textContent = nextText;
        }

        function patchFrontendCopy(root) {
          var scope = root && root.querySelectorAll ? root : document;

          scope.querySelectorAll('a[href*="/collections/brazi"]').forEach(function (link) {
            if ((link.textContent || '').trim() === 'Brazi') {
              link.textContent = 'Brazil';
            }
            if ((link.getAttribute('aria-label') || '').trim() === 'Brazi') {
              link.setAttribute('aria-label', 'Brazil');
            }
            if ((link.getAttribute('title') || '').trim() === 'Brazi') {
              link.setAttribute('title', 'Brazil');
            }
          });

          scope.querySelectorAll('img[alt="Brazi"]').forEach(function (img) {
            img.setAttribute('alt', 'Brazil');
          });

          scope.querySelectorAll('a[href*="/account/login"]').forEach(function (link) {
            if ((link.textContent || '').trim() === 'Sign/Login') {
              link.textContent = 'Sign in / Log in';
            }
          });

          scope.querySelectorAll('a[href="#"]').forEach(function (link) {
            var text = (link.textContent || '').trim();
            if (text.includes('Working Hours: 24/7 Support')) {
              setTextIfNeeded(link, 'Customer support: available 24/7');
            }
          });

          scope.querySelectorAll('*').forEach(function (node) {
            if (node.children.length > 0) return;
            var text = (node.textContent || '').trim();
            if (text === 'Brazi') {
              setTextIfNeeded(node, 'Brazil');
            }
          });
        }

        function startPatcher() {
          patchFrontendCopy(document);

          var observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
              mutation.addedNodes.forEach(function (node) {
                if (node && node.nodeType === 1) {
                  patchFrontendCopy(node);
                }
              });
            });
          });

          observer.observe(document.body, { childList: true, subtree: true });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', startPatcher);
        } else {
          startPatcher();
        }
      })();
    </script>
