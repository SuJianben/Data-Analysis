    <script>
      (() => {
        const modal = document.querySelector('[data-fkk-alove-modal]');
        if (!modal) return;

        const cta = modal.querySelector('.fkk-alove-modal__cta');

        const openModal = (openButton) => {
          modal.hidden = false;
          openButton.setAttribute('aria-expanded', 'true');
          document.documentElement.classList.add('fkk-alove-modal-open');
          window.setTimeout(() => {
            if (cta) cta.focus();
          }, 40);
        };

        const closeModal = () => {
          const openButton = document.querySelector('[data-fkk-alove-open]');
          modal.hidden = true;
          if (openButton) {
            openButton.setAttribute('aria-expanded', 'false');
            openButton.focus();
          }
          document.documentElement.classList.remove('fkk-alove-modal-open');
        };

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;

          const openButton = event.target.closest('[data-fkk-alove-open]');
          if (openButton) {
            openModal(openButton);
            return;
          }

          const closeButton = event.target.closest('[data-fkk-alove-close]');
          if (closeButton && modal.contains(closeButton)) closeModal();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !modal.hidden) closeModal();
        });
      })();
    </script>
