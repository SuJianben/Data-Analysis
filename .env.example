# Google Analytics 4
GA4_PROPERTY_ID=546810508
# TMS 的纯数字 GA4 媒体资源 ID，不是 G- 开头的衡量 ID
TMS_GA4_PROPERTY_ID=
# FKK 的纯数字 GA4 媒体资源 ID，不是 G- 开头的衡量 ID
FKK_GA4_PROPERTY_ID=
# BLK 的纯数字 GA4 媒体资源 ID，不是 G- 开头的衡量 ID
BLK_GA4_PROPERTY_ID=
DTK_GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
# 本机 OAuth 长期认证（三项需同时填写）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 服务账号备用方式
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json

# Microsoft Clarity
CLARITY_API_TOKEN=

# 用户行为事件接收（可选；设置后要求请求带 x-tkf-ingest-key）
USER_EVENT_INGEST_KEY=
# 浏览器请求允许来源，多个域名用英文逗号分隔
USER_EVENT_ALLOWED_ORIGINS=https://turkforma.com,https://www.turkforma.com,https://mezkiraly.com,https://www.mezkiraly.com,https://footballkituk.com,https://www.footballkituk.com,https://belgiumkits.com,https://www.belgiumkits.com,https://deintrikot.at,https://www.deintrikot.at
# Cloudflare Worker 事件代理与 KV 快照中转
USER_EVENT_FORWARD_URL=
USER_EVENT_FORWARD_KEY=
# 可单独设置读取密钥；留空时快照读取复用 USER_EVENT_FORWARD_KEY
USER_EVENT_API_URL=
USER_EVENT_READ_KEY=
# Vercel 接收后写入队列，本机自动消费
USER_EVENT_STORAGE_MODE=local
USER_EVENT_QUEUE_TOPIC=signal-user-events-v1
USER_EVENT_QUEUE_REGION=fra1
USER_EVENT_QUEUE_CONSUMER=local-sqlite-v1
LOCAL_QUEUE_TOKEN_URL=https://你的面板域名/api/sync/queue-token
# 本地主库读取与 Vercel 展示
ANALYTICS_READ_MODE=local
ANALYTICS_DATABASE_PATH=data/analytics.db
LOCAL_SYNC_URL=http://localhost:3000/api/sync/ga4

# 外部同步导入（可选；设置后 /api/import 要求请求带 x-tkf-import-key）
IMPORT_INGEST_KEY=

# OpenAI-compatible AI endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
