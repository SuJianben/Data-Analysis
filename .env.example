# Google Analytics 4
GA4_PROPERTY_ID=546810508
GA4_ACCESS_TOKEN=
# 本机 OAuth 长期认证（三项需同时填写）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 服务账号备用方式
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json

# Microsoft Clarity
CLARITY_API_TOKEN=

# 用户行为事件接收（可选；设置后要求请求带 x-tkf-ingest-key）
USER_EVENT_INGEST_KEY=
# 浏览器请求允许来源，多个域名用英文逗号分隔
USER_EVENT_ALLOWED_ORIGINS=https://turkforma.com,https://www.turkforma.com
# HTTPS 接入层转发到 Cloudflare Worker 时使用；直接提交 Worker 可不配置
USER_EVENT_FORWARD_URL=
USER_EVENT_FORWARD_KEY=
# 用户页面读取 Cloudflare Worker（仅服务端使用，不要加 NEXT_PUBLIC_）
USER_EVENT_API_URL=
USER_EVENT_READ_KEY=
# 可选：指定 SQLite 持久化文件位置
TKF_DATABASE_PATH=

# 外部同步导入（可选；设置后 /api/import 要求请求带 x-tkf-import-key）
IMPORT_INGEST_KEY=

# 本机自动同步脚本（不填入代码仓库，写入本机环境变量或 .env.local）
TKF_IMPORT_URL=http://localhost:3000/api/import
TKF_IMPORT_KEY=
LOCAL_SYNC_URL=http://localhost:3000/api/sync/ga4

# OpenAI-compatible AI endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
